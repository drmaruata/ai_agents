# Cloud control plane
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-side Postgres connection used by the FastAPI control plane.
# Use the Supabase session pooler connection string for application workloads where appropriate.
DATABASE_URL=

# Dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local bridge
RUATA_CONTROL_PLANE_URL=ws://localhost:8000/ws/bridge
RUATA_DEVICE_ID=
RUATA_DEVICE_TOKEN=
RUATA_LOCAL_WORKSPACE=

# Development-only authentication fallback. Production must use Supabase Auth.
JWT_SECRET=development-only-change-me
LOCAL_BRIDGE_TOKEN=

# Model provider / OpenAI Agents SDK
OPENAI_API_KEY=
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_API_KEY=

# Do not commit .env or real credentials.
