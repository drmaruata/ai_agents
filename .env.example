# Cloud control plane
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000

# Dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local bridge
RUATA_CONTROL_PLANE_URL=ws://localhost:8000/ws/bridge
RUATA_DEVICE_ID=
RUATA_DEVICE_TOKEN=
RUATA_LOCAL_WORKSPACE=

# Authentication
JWT_SECRET=development-only-change-me
LOCAL_BRIDGE_TOKEN=

# Model provider / OpenAI Agents SDK
# The Agents SDK uses OPENAI_API_KEY for OpenAI models.
OPENAI_API_KEY=
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_API_KEY=

# Database (use a real secret only in local secure storage / deployment environment)
DATABASE_URL=postgresql://ruata:ruata@localhost:5432/ruata
